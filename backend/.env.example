# Generate SECRET_KEY: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_URL=postgresql+psycopg2://sgd:CAMBIAR@127.0.0.1:5432/sgd_desarrollo
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Respaldos privados. PostgreSQL requiere pg_dump de una versión compatible.
# En Windows se detecta la instalación estándar de PostgreSQL.
PG_DUMP_PATH=pg_dump
BACKUP_SCHEDULER_ENABLED=true
# BACKUP_DIR=C:/ruta/privada/respaldos
