# COPIAR A .env SOLO EN EL VPS. No publicar .env ni compartir sus valores.
# Crear un registro DNS A del subdominio hacia la IP publica del VPS.
DOMAIN=sgd.ejemplo.com

# Usar contrasenas hexadecimales (openssl rand -hex 32) para evitar caracteres
# que requieran codificacion especial dentro de DATABASE_URL.
POSTGRES_PASSWORD=CAMBIAR_POR_64_CARACTERES_HEXADECIMALES
SECRET_KEY=CAMBIAR_POR_96_CARACTERES_HEXADECIMALES
DEMO_PASSWORD=CAMBIAR_POR_48_CARACTERES_HEXADECIMALES

# true SOLO para una base de evaluacion aislada con datos ficticios.
# La base del despliegue de esta plantilla se llama sgd_evaluacion.
DEMO_SEED_ENABLED=false
